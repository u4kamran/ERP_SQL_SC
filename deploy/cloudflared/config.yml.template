# Cloudflare Tunnel configuration for AH Steel Lab
# Generated by deploy/setup-cloudflare.ps1 — do not commit credentials.

tunnel: {{TUNNEL_ID}}
credentials-file: {{CREDENTIALS_FILE}}

ingress:
  - hostname: {{HOSTNAME}}
    service: http://127.0.0.1:{{PORT}}
    originRequest:
      connectTimeout: 10s
      keepAliveTimeout: 30s
      keepAliveConnections: 8
      disableChunkedEncoding: true
  - service: http_status:404
