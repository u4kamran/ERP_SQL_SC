# =============================================================================
# AH Steel Lab - PRODUCTION (Cloudflare Tunnel)
# Copy to .env on the server:  copy .env.production.example .env
# =============================================================================

# Application
APP_NAME=AH Steel Lab
APP_ENV=production
DEBUG=false
SECRET_KEY=REPLACE-WITH-64-CHAR-RANDOM-SECRET-KEY-USE-POWERSHELL-TO-GENERATE
API_V1_PREFIX=/api/v1

# Server (bind locally; Cloudflare Tunnel forwards public traffic)
HOST=127.0.0.1
PORT=8000

# Domain / URLs (no trailing slash)
BASE_URL=https://app.ahsteellab.com
FRONTEND_URL=https://app.ahsteellab.com

# Database
DB_SERVER=SHAHEENHPLT\SQLEXPRESS
DB_NAME=NSDS2626_AUTH
DB_USER=sa
DB_PASSWORD=REPLACE-WITH-YOUR-DB-PASSWORD
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=yes
DB_ENCRYPT=no

BUSINESS_DB_SERVER=shahenhp
BUSINESS_DB_NAME=nsds2626

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_REMEMBER_ME_EXPIRE_DAYS=30

# Security
BCRYPT_ROUNDS=12
CSRF_SECRET_KEY=REPLACE-WITH-32-CHAR-MINIMUM-CSRF-SECRET-KEY
CSRF_COOKIE_NAME=csrftoken
SESSION_COOKIE_NAME=session_id
SECURE_COOKIES=true
SAMESITE_COOKIES=lax

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_HISTORY_COUNT=5
PASSWORD_EXPIRY_DAYS=90
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=24

# Account Lockout
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

# Session
MAX_CONCURRENT_SESSIONS=5

# CORS
CORS_ORIGINS=https://app.ahsteellab.com

# Host validation
ALLOWED_HOSTS=app.ahsteellab.com,localhost,127.0.0.1

# Cloudflare
TRUST_PROXY_HEADERS=true
CLOUDFLARE_IP_HEADER=CF-Connecting-IP
CLOUDFLARE_TUNNEL_HOSTNAME=app.ahsteellab.com

# Email
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@ahsteellab.com
SMTP_FROM_NAME=AH Steel Lab

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Default Admin (seed script only)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@ahsteellab.com
DEFAULT_ADMIN_PASSWORD=ChangeMe@2026!
