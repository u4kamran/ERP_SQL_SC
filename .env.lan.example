# =============================================================================
# LAN SYNC — Your two machines (no internet)
# Machine 1 MAIN:    shaheenhp  / 192.168.92.103  — SQL Server 2008
# Machine 2 BACKUP:  shaheenac  / 192.168.92.215  — SQL Server 2008
# Folder on backup:  D:\DB_2626  ( .bak files + data\ for .mdf/.ldf )
# =============================================================================

SYNC_ENABLED=true
SYNC_LAN_ONLY=true

# Machine 2 — backup SQL Server
SYNC_REMOTE_SERVER=192.168.92.215
SYNC_REMOTE_USER=sa
SYNC_REMOTE_PASSWORD=redgreen

# Share on shaheenac (create share for D:\DB_2626 — see SETUP-MACHINE2-SHARE.bat)
SYNC_REMOTE_BACKUP_SHARE=\\shaheenac\DB_2626
SYNC_REMOTE_RESTORE_DIR=D:\DB_2626

SYNC_BACKUP_DIR=data/sync/backups
SYNC_AUTH_DB=true
SYNC_BUSINESS_DB=true
SYNC_INTERVAL_MINUTES=1440
SYNC_KEEP_LOCAL_BACKUPS=2

# Databases (same names on both machines):
#   NSDS2626_AUTH  +  nsds2626
#
# SQL Server 2008 notes:
#   - Mixed Mode + sa enabled on both PCs
#   - DB_ENCRYPT=no (already in .env) — required for SQL 2008
#   - On MAIN PC: SQL service account needs write access to SYNC_BACKUP_DIR
#   - On BACKUP PC: create D:\DB_2626\data for restored .mdf/.ldf files
