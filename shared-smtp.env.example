# Shared SMTP for ERP + ARP (same Gmail account)
# Copy to shared-smtp.env and fill in, OR run CONFIGURE-SMTP.bat once
# Location: D:\CursorProject\shared-smtp.env

SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your@gmail.com
