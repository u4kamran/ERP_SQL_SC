APP_NAME=Shafique Departmental Store
COMPANY_NAME=Shafique Departmental Store
APP_ENV=production
DEBUG=false
SECRET_KEY=__GENERATE_SECRET_KEY__
API_V1_PREFIX=/api/v1

HOST=127.0.0.1
PORT=8000

BASE_URL=https://erp.ahsteellab.com
FRONTEND_URL=https://erp.ahsteellab.com

DB_SERVER=shaheenhp
DB_NAME=NSDS2626_AUTH
DB_USER=sa
DB_PASSWORD=redgreen
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=yes
DB_ENCRYPT=no

BUSINESS_DB_SERVER=shaheenhp
BUSINESS_DB_NAME=nsds2626

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_REMEMBER_ME_EXPIRE_DAYS=30

BCRYPT_ROUNDS=12
CSRF_SECRET_KEY=__GENERATE_CSRF_KEY__
CSRF_COOKIE_NAME=csrftoken
SESSION_COOKIE_NAME=session_id
SECURE_COOKIES=true
SAMESITE_COOKIES=lax

PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_HISTORY_COUNT=5
PASSWORD_EXPIRY_DAYS=90
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=24

MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30
MAX_CONCURRENT_SESSIONS=5

CORS_ORIGINS=https://erp.ahsteellab.com
ALLOWED_HOSTS=erp.ahsteellab.com,localhost,127.0.0.1

TRUST_PROXY_HEADERS=true
CLOUDFLARE_IP_HEADER=CF-Connecting-IP
CLOUDFLARE_TUNNEL_HOSTNAME=erp.ahsteellab.com

SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Shafique Departmental Store

LOG_LEVEL=INFO
LOG_FILE=logs/app.log

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@ahsteellab.com
DEFAULT_ADMIN_PASSWORD=ChangeMe@2026!
