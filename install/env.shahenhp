# =============================================================================
# AH Steel Lab - SHAHENHP / NSDS2626 environment
# Copied to .env by install\install.bat
# =============================================================================

APP_NAME=AH Steel Lab
APP_ENV=development
DEBUG=true
SECRET_KEY=__GENERATE_SECRET_KEY__
API_V1_PREFIX=/api/v1

HOST=0.0.0.0
PORT=8000

BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8000

# Auth database (naming: {business_db}_AUTH)
DB_SERVER=shahenhp
DB_NAME=NSDS2626_AUTH
DB_USER=sa
DB_PASSWORD=redgreen
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=yes
DB_ENCRYPT=no

# Legacy business database (VB6 data)
BUSINESS_DB_SERVER=shahenhp
BUSINESS_DB_NAME=nsds2626

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_REMEMBER_ME_EXPIRE_DAYS=30

BCRYPT_ROUNDS=12
CSRF_SECRET_KEY=__GENERATE_CSRF_KEY__
CSRF_COOKIE_NAME=csrftoken
SESSION_COOKIE_NAME=session_id
SECURE_COOKIES=false
SAMESITE_COOKIES=lax

PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_HISTORY_COUNT=5
PASSWORD_EXPIRY_DAYS=90
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=24

MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30
MAX_CONCURRENT_SESSIONS=5

CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ALLOWED_HOSTS=*

TRUST_PROXY_HEADERS=true
CLOUDFLARE_IP_HEADER=CF-Connecting-IP
CLOUDFLARE_TUNNEL_HOSTNAME=app.ahsteellab.com

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@ahsteellab.com
SMTP_FROM_NAME=AH Steel Lab

LOG_LEVEL=INFO
LOG_FILE=logs/app.log

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@ahsteellab.com
DEFAULT_ADMIN_PASSWORD=ChangeMe@2026!
