# =============================================================================
# AH Steel Lab - Environment Configuration
# Copy this file to .env and update values for your environment.
# =============================================================================

# Application
APP_NAME=AH Steel Lab
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-long-random-secret-key-at-least-64-chars
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Domain / URLs (no trailing slash)
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8000

# Database - Authentication Database (separate from business DB; use {BUSINESS_DB_NAME}_AUTH)
DB_SERVER=shahenhp
DB_NAME=NSDS2626_AUTH
DB_USER=sa
DB_PASSWORD=redgreen
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=yes
DB_ENCRYPT=no

# Legacy Business Database (read-only reference for future phases - DO NOT MODIFY)
BUSINESS_DB_SERVER=shahenhp
BUSINESS_DB_NAME=nsds2626

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_REMEMBER_ME_EXPIRE_DAYS=30

# Security
BCRYPT_ROUNDS=12
CSRF_SECRET_KEY=change-this-csrf-secret-key-must-be-32-chars-min
CSRF_COOKIE_NAME=csrftoken
SESSION_COOKIE_NAME=session_id
SECURE_COOKIES=false
SAMESITE_COOKIES=lax

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_HISTORY_COUNT=5
PASSWORD_EXPIRY_DAYS=90
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=24

# Account Lockout
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

# Session
MAX_CONCURRENT_SESSIONS=5

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:8000,http://localhost,https://app.ahsteellab.com,https://ahsteellab.com

# Host validation (comma-separated; * = allow all — use specific hosts in production)
ALLOWED_HOSTS=*

# Cloudflare
TRUST_PROXY_HEADERS=true
CLOUDFLARE_IP_HEADER=CF-Connecting-IP
CLOUDFLARE_TUNNEL_HOSTNAME=app.ahsteellab.com

# Email (password reset - ready for future SMTP configuration)
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@ahsteellab.com
SMTP_FROM_NAME=AH Steel Lab

# WhatsApp (Meta Cloud API — automatic PDF send from GL Ledger)
WHATSAPP_ENABLED=false
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_BOT_ENABLED=true

# Guest web chat mobile authentication (OTP via WhatsApp Cloud API)
# WhatsApp channel does not need OTP — Meta already authenticates the sender.
GUEST_MOBILE_OTP_REQUIRED=true
# Local testing only: include OTP in API response / logs when WhatsApp send is unavailable
GUEST_MOBILE_OTP_DEV_ECHO=false

# Gemini Vision + voice STT (guest chat / WhatsApp voice notes)
# Put the real key only in local .env — never commit secrets
GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.1-flash-lite

# Database sync — local SQL Server -> online SQL Server (backup + restore)
# Recommended: run nightly (10 GB business DB). Online server must read SYNC_REMOTE_BACKUP_SHARE.
SYNC_ENABLED=false
SYNC_REMOTE_SERVER=
SYNC_REMOTE_USER=
SYNC_REMOTE_PASSWORD=
SYNC_REMOTE_BACKUP_SHARE=
# Local path on BACKUP PC for RESTORE (e.g. D:\SQLBackup) — use with LAN two-machine setup
SYNC_REMOTE_RESTORE_DIR=
# true = only allow 192.168.x.x / local PC names (no internet sync)
SYNC_LAN_ONLY=true
SYNC_BACKUP_DIR=data/sync/backups
SYNC_AUTH_DB=true
SYNC_BUSINESS_DB=true
SYNC_INTERVAL_MINUTES=1440
SYNC_KEEP_LOCAL_BACKUPS=2

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Default Admin (used only during initial seed - change password on first login)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@ahsteellab.com
DEFAULT_ADMIN_PASSWORD=ChangeMe@2026!
